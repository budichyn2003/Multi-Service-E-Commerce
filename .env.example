# =============================================================================
# MarketForge — Environment Configuration (EXAMPLE — copy to .env)
# Never commit real secrets. See SECURITY.md.
# =============================================================================

# --- Environment -------------------------------------------------------------
NODE_ENV=development
APP_ENV=development

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=marketforge
POSTGRES_PASSWORD=marketforge
POSTGRES_DB=marketforge
# Local (non-docker) override:
# POSTGRES_HOST=localhost

DATABASE_URL=postgres://marketforge:marketforge@postgres:5432/marketforge

# --- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=marketforge
RABBITMQ_PASSWORD=marketforge
RABBITMQ_URL=amqp://marketforge:marketforge@rabbitmq:5672/
RABBITMQ_MGMT_PORT=15672

# --- Service URLs (docker network) -------------------------------------------
COMMERCE_GO_URL=http://commerce-go:8080
ORDER_SERVICE_URL=http://order-service:8080
NOTIFICATION_SERVICE_URL=http://notification-service:8080
AI_SERVICE_URL=http://ai-service:8000
GATEWAY_URL=http://gateway:3000

# --- Exposed ports (host) ----------------------------------------------------
GATEWAY_PORT=8080
COMMERCE_GO_PORT=8081
ORDER_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
AI_SERVICE_PORT=8084
WEB_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
MAILHOG_HTTP_PORT=8025

# --- Auth / JWT --------------------------------------------------------------
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=900s          # 15 minutes
JWT_REFRESH_TTL=30d          # 30 days

# --- Payment Gateway (sandbox) -----------------------------------------------
PAYMENT_PROVIDER=midtrans-sandbox
PAYMENT_SERVER_KEY=SB-Mid-server-REPLACE_ME
PAYMENT_CLIENT_KEY=SB-Mid-client-REPLACE_ME
PAYMENT_WEBHOOK_SECRET=replace-me-webhook-secret
PAYMENT_CALLBACK_BASE_URL=http://localhost:8080

# --- Email (MailHog locally) -------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@marketforge.local

# --- Object Storage (S3-compatible) ------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=marketforge-dev
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me

# --- OAuth -------------------------------------------------------------------
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/oauth/google/callback

# --- AI / LLM ----------------------------------------------------------------
LLM_PROVIDER=openai
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOKENS=1024

# --- Observability -----------------------------------------------------------
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
