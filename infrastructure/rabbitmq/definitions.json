{
  "users": [],
  "vhosts": [
    { "name": "/" }
  ],
  "permissions": [],
  "exchanges": [
    {
      "name": "marketforge.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "notifications.orders",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "marketforge.dlx",
        "x-dead-letter-routing-key": "notifications.orders.dlq",
        "x-message-ttl": 300000
      }
    },
    {
      "name": "notifications.orders.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "analytics.orders",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "marketforge.dlx",
        "x-dead-letter-routing-key": "analytics.orders.dlq",
        "x-message-ttl": 300000
      }
    },
    {
      "name": "analytics.orders.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "search.products",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "marketforge.dlx",
        "x-dead-letter-routing-key": "search.products.dlq",
        "x-message-ttl": 300000
      }
    },
    {
      "name": "search.products.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "marketforge.events",
      "vhost": "/",
      "destination": "notifications.orders",
      "destination_type": "queue",
      "routing_key": "order.*",
      "arguments": {}
    },
    {
      "source": "marketforge.events",
      "vhost": "/",
      "destination": "analytics.orders",
      "destination_type": "queue",
      "routing_key": "order.*",
      "arguments": {}
    },
    {
      "source": "marketforge.events",
      "vhost": "/",
      "destination": "search.products",
      "destination_type": "queue",
      "routing_key": "product.*",
      "arguments": {}
    }
  ],
  "policies": [
    {
      "name": "dlx-retry",
      "vhost": "/",
      "apply-to": "queues",
      "pattern": "^(?!.*dlq).*$",
      "definition": {
        "dead-letter-exchange": "marketforge.dlx"
      },
      "priority": 1
    }
  ]
}
